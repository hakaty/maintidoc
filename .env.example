# Copy to .env and adjust. Never commit the real .env (it is git-ignored).
#
# M7.5 Docker note: when running via `docker compose --profile app up -d`,
# DATABASE_URL, OLLAMA_BASE_URL, DEVICE and EMBED_QUERY_DEVICE below are
# OVERRIDDEN by docker-compose.yml's `environment:` block (the in-network
# hostnames "db"/"host.docker.internal" and DEVICE=cpu) -- this file's
# values here are for the NATIVE `python -m streamlit run ...` workflow.
# LLM_PROVIDER and OPENROUTER_API_KEY are NOT overridden: set them here for
# both workflows. See docs/07_docker.md.

# --- Database (PostgreSQL 16 + pgvector) ---------------------------------
# Host port 5433, not the default 5432: avoids clashing with any other
# PostgreSQL already running on this machine (see docker-compose.yml).
# 127.0.0.1, not "localhost": avoids slow hostname resolution on some setups.
DATABASE_URL=postgresql://maintidoc:maintidoc@127.0.0.1:5433/maintidoc
POSTGRES_USER=maintidoc
POSTGRES_PASSWORD=maintidoc
POSTGRES_DB=maintidoc

# --- LLM provider: ollama (default, local) | openrouter (fallback) -------
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_VLM_MODEL=qwen2.5vl:3b

# Required only when LLM_PROVIDER=openrouter -- never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=qwen/qwen-2.5-7b-instruct
OPENROUTER_VLM_MODEL=qwen/qwen-2.5-vl-3b-instruct

# --- Embeddings (loaded starting M3/M4) ------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=1024
CLIP_MODEL=MobileCLIP-S2
CLIP_PRETRAINED=datacompdr

# --- PGVector (M4) ----------------------------------------------------------
PGVECTOR_TEXT_TABLE=maintidoc_text
PGVECTOR_IMAGE_TABLE=maintidoc_images
PGVECTOR_TEXT_DIM=1024
PGVECTOR_IMAGE_DIM=512
PGVECTOR_HYBRID_SEARCH=true
PGVECTOR_TEXT_SEARCH_CONFIG=french

# --- Device (M5 section 0): auto picks cuda if available else cpu, logged --
# EMBED_QUERY_DEVICE overrides DEVICE for single-query BGE-M3 embeddings only
# (e.g. "cpu" to keep the GPU free for Qwen during retrieval). Empty = DEVICE.
DEVICE=auto
EMBED_QUERY_DEVICE=

# --- RAG (M5) ----------------------------------------------------------------
RAG_K=8
RAG_MAX_NODES=6
RAG_CONTEXT_BUDGET_TOKENS=2500
RAG_MIN_SCORE=0.50
RAG_TEMPERATURE=0.1
RAG_NUM_PREDICT=600
RAG_NUM_CTX=8192

# --- Image search thresholds (M7.4 section 3, recalibrated M7.4b section 2) -
# Calibrated on real data (scripts/_calibrate_image_threshold.py) across a
# larger/harder set: perturbed figure crops + full-page "screen photo"
# simulations vs. 66 locally-generated unrelated images. Below
# IMAGE_MIN_SCORE: a clear "no match" empty state. Between the two: shown as
# "Correspondances possibles -- a verifier", never as a confident match.
# Above IMAGE_REVIEW_SCORE: eligible for "Meilleure correspondance".
IMAGE_MIN_SCORE=0.64
IMAGE_REVIEW_SCORE=0.76

# --- Paths ------------------------------------------------------------------
MEDIA_DIR=data/media
PDF_PATH=data/pdf/document.pdf
MODELS_DIR=models
