.env
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Single input PDF and extracted media: never committed.
data/pdf/*
!data/pdf/.gitkeep
!data/pdf/README.md
data/media/*
!data/media/.gitkeep

# Extraction pipeline output (M2): fully regenerable from data/pdf/.
data/processed/

# scripts/export_index.py output: a packaged copy of data/processed +
# data/media for a colleague -- regenerable, not committed (same reason as
# those two directories above).
exports/

# Synthetic test fixtures are regenerated by tests, not committed.
tests/fixtures/*
!tests/fixtures/.gitkeep

# Model weights / caches (CLIP, BGE-M3, HF, torch).
models/
.cache/

# Retrieval eval output (M4): regenerable via eval/run_retrieval.py.
eval/results.json

# Claude Code tool state / scratch debug logs, not part of the project.
.claude/
eval/agent_run_debug.log

# scripts/_calibrate_image_threshold.py output: locally-generated perturbed
# in-domain / out-of-domain calibration images -- regenerable, not committed
# (same reason as tests/fixtures above). docs/diagnostics/page5.png (the
# actual diagnosis evidence) is kept.
docs/diagnostics/image_threshold/

# M7.4b section 2: real product photos used manually to sanity-check the
# image-search threshold (not authored by this project) -- never committed,
# same reasoning as the single input PDF above.
data/test_photos/

.env
data/pdf/
data/test_photos/
exports/
dist/
*.zip
*.sql
*.dump

docs/diagnostics/*.png
